# Local Netlify folder
.netlify

# Credentials and secrets (§13.5 hardening)
*credentials*.json
*credentials*.yaml
*credentials*.yml
*secret*.json
*secret*.yaml
*secret*.yml
*private*.json
*private*.pem
*private*.key
*.pem
*.key
.env
.env.*
!.env.example
secrets/
secure-keys/

# Wallet and key storage
*wallet*.json
*seed*.txt
*mnemonic*.txt

# Dependency trees. This repository is its own Netlify publish directory
# (publish = "." in netlify.toml), so anything committed here is served on the
# live domain. A node_modules tree would be published in full.
node_modules/
**/node_modules/

# Python bytecode. tools/make-sitemap.py and tools/check-sitemap.py write it on every run,
# and a tracked .pyc showed as modified after every sitemap regeneration (2026-08-24).
__pycache__/
*.pyc

# The built publish directory (tools/build-site.sh). Netlify builds it; never commit it.
_site/
